{
  "expo": {
    "name": "DropPing",
    "slug": "dropping",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.webwave.dropping"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050B1A"
      },
      "package": "com.webwave.dropping"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "DropPing needs access to your contacts to save received contact information."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DropPing needs access to your photos to send files."
        }
      ],
      "expo-asset"
    ]
  }
}
